{
  "name": "hypermarket-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky install",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
